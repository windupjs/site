---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { Content } from '../changelog.md';
---

<Layout title="Changelog · Windup">
  <Header />
  <main class="wrap changelog-page">
    <article class="prose">
      <Content />
    </article>
  </main>
  <Footer />
</Layout>

<style>
  .changelog-page { padding: 48px 0 72px; }
  .changelog-page .prose { max-width: 760px; }
  /* Give each release a subtle divider + monospace version heading. */
  .changelog-page :global(.prose h2) {
    font-family: var(--font-mono); color: var(--accent);
    margin-top: 40px; padding-top: 24px; border-top: 1px solid var(--line);
    font-size: 20px;
  }
  .changelog-page :global(.prose h1) { margin-bottom: 6px; }
</style>
