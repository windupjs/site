---
import '../styles/global.css';
import { getUi, getLangFromUrl, htmlLang, switchLocalePath, LOCALES } from '../i18n';

const lang = getLangFromUrl(Astro.url);
const c = getUi(lang);

interface Props {
  title?: string;
  description?: string;
}

const {
  title = c.meta.title,
  description = c.meta.description,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/brand/windup-icon.png', Astro.site);
const OG_LOCALE: Record<string, string> = { en: 'en_US', pt: 'pt_BR', es: 'es_ES', zh: 'zh_CN' };
const alternates = LOCALES.map((l) => ({
  hreflang: htmlLang(l),
  href: new URL(switchLocalePath(Astro.url, l), Astro.site).href,
}));
const xDefault = new URL(switchLocalePath(Astro.url, 'en'), Astro.site).href;
---

<!doctype html>
<html lang={htmlLang(lang)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />

    <!-- Locale alternates -->
    {alternates.map((a) => (
      <link rel="alternate" hreflang={a.hreflang} href={a.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={xDefault} />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#16130E" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#FAF8F3" media="(prefers-color-scheme: light)" />

    <!-- Anti-flash theme init: apply saved theme before first paint -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('windup-theme');
          if (t === 'light' || t === 'dark') {
            document.documentElement.setAttribute('data-theme', t);
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
