---
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { docsNav, docsOrder } from '../data/docsNav';
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';

interface Props {
  entry: CollectionEntry<'docs'>;
  headings: MarkdownHeading[];
}

const { entry, headings } = Astro.props;
const currentSlug = entry.slug;

const toc = headings.filter((h) => h.depth === 2);

const idx = docsOrder.findIndex((d) => d.slug === currentSlug);
const prev = idx > 0 ? docsOrder[idx - 1] : null;
const next = idx >= 0 && idx < docsOrder.length - 1 ? docsOrder[idx + 1] : null;

const href = (slug: string) => (slug === 'getting-started' ? '/docs' : `/docs/${slug}`);

const title = `${entry.data.title} · Windup docs`;
---

<Layout title={title} description={entry.data.description}>
  <Header />

  <div class="docs-shell">
    <!-- Sidebar (desktop) -->
    <aside class="docs-sidebar" aria-label="Documentation">
      {docsNav.map((group) => (
        <div class="group">
          <p class="group-title">{group.title}</p>
          <ul>
            {group.items.map((item) => (
              <li>
                <a href={href(item.slug)} aria-current={item.slug === currentSlug ? 'page' : undefined}>
                  {item.label}
                </a>
                {item.slug === currentSlug && toc.length > 0 && (
                  <ul class="toc-sub">
                    {toc.map((h) => (
                      <li><a href={`#${h.slug}`}>{h.text}</a></li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </aside>

    <main class="docs-main">
      <!-- Mobile page picker -->
      <div class="docs-mobile-nav">
        <label class="visually-hidden" for="docs-jump">Jump to a docs page</label>
        <select id="docs-jump" onchange="if(this.value)location.href=this.value">
          {docsNav.map((group) => (
            <optgroup label={group.title}>
              {group.items.map((item) => (
                <option value={href(item.slug)} selected={item.slug === currentSlug}>{item.label}</option>
              ))}
            </optgroup>
          ))}
        </select>
      </div>

      {currentSlug === 'getting-started' && (
        <aside class="docs-ai-note">
          <strong>Using an AI assistant?</strong> Point it at
          <a href="/llms.txt"><code>/llms.txt</code></a> — or
          <a href="/llms-full.txt"><code>/llms-full.txt</code></a> for the whole thing in one file —
          then describe your flows. It can author and run the scenarios for you.
        </aside>
      )}

      <article class="prose">
        <slot />
      </article>

      <nav class="docs-pager" aria-label="Pagination">
        {prev ? (
          <a class="prev" href={href(prev.slug)}>
            <span class="dir">← Previous</span>
            <span class="pg-label">{prev.label}</span>
          </a>
        ) : <span></span>}
        {next ? (
          <a class="next" href={href(next.slug)}>
            <span class="dir">Next →</span>
            <span class="pg-label">{next.label}</span>
          </a>
        ) : <span></span>}
      </nav>
    </main>
  </div>

  <Footer />
</Layout>
