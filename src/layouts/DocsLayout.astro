---
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { docsNav, docsOrder } from '../data/docsNav';
import { getUi, getLangFromUrl, localizedPath } from '../i18n';
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';

interface Props {
  entry: CollectionEntry<'docs'>;
  headings: MarkdownHeading[];
}

const { entry, headings } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const c = getUi(lang);
const t = c.docs;

// entry.slug is like "en/getting-started" — the bare slug drives nav/labels
const currentSlug = entry.slug.split('/').slice(1).join('/');
const label = (slug: string) => t.labels[slug as keyof typeof t.labels] ?? slug;
const href = (slug: string) =>
  slug === 'getting-started' ? localizedPath(lang, '/docs') : localizedPath(lang, `/docs/${slug}`);

const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const onThisPage = (t as { onThisPage?: string }).onThisPage ?? 'On this page';
const idx = docsOrder.indexOf(currentSlug);
const prev = idx > 0 ? docsOrder[idx - 1] : null;
const next = idx >= 0 && idx < docsOrder.length - 1 ? docsOrder[idx + 1] : null;

const title = `${entry.data.title}${c.meta.docsTitleSuffix}`;
---

<Layout title={title} description={entry.data.description}>
  <Header />

  <div class="docs-shell">
    <!-- Sidebar (desktop) -->
    <aside class="docs-sidebar" aria-label={t.ariaSidebar}>
      {docsNav.map((group) => (
        <div class="group">
          <p class="group-title">{t.groups[group.key]}</p>
          <ul>
            {group.items.map((slug) => (
              <li>
                <a href={href(slug)} aria-current={slug === currentSlug ? 'page' : undefined}>
                  {label(slug)}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </aside>

    <main class="docs-main">
      <!-- Mobile page picker -->
      <div class="docs-mobile-nav">
        <label class="visually-hidden" for="docs-jump">{t.mobileJump}</label>
        <select id="docs-jump" onchange="if(this.value)location.href=this.value">
          {docsNav.map((group) => (
            <optgroup label={t.groups[group.key]}>
              {group.items.map((slug) => (
                <option value={href(slug)} selected={slug === currentSlug}>{label(slug)}</option>
              ))}
            </optgroup>
          ))}
        </select>
      </div>

      {currentSlug === 'getting-started' && (
        <aside class="docs-ai-note" set:html={t.aiNoteHtml}></aside>
      )}

      <article class="prose">
        <slot />
      </article>

      <nav class="docs-pager" aria-label={t.ariaPager}>
        {prev ? (
          <a class="prev" href={href(prev)}>
            <span class="dir">← {t.prev}</span>
            <span class="pg-label">{label(prev)}</span>
          </a>
        ) : <span></span>}
        {next ? (
          <a class="next" href={href(next)}>
            <span class="dir">{t.next} →</span>
            <span class="pg-label">{label(next)}</span>
          </a>
        ) : <span></span>}
      </nav>
    </main>

    <!-- On this page (desktop) -->
    {toc.length > 1 && (
      <aside class="docs-toc" aria-label={onThisPage}>
        <p class="toc-title">{onThisPage}</p>
        <ul>
          {toc.map((h) => (
            <li class={h.depth === 3 ? 'sub' : ''}><a href={`#${h.slug}`} data-toc={h.slug}>{h.text}</a></li>
          ))}
        </ul>
      </aside>
    )}
  </div>

  <Footer />

  <script>
    // Scroll-spy: highlight the "On this page" link for the section in view.
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.docs-toc a[data-toc]'));
    if (links.length) {
      const byId = new Map(links.map((a) => [a.dataset.toc, a]));
      const heads = links.map((a) => document.getElementById(a.dataset.toc!)).filter(Boolean) as HTMLElement[];
      let active: HTMLAnchorElement | null = null;
      const setActive = (id: string | undefined) => {
        if (!id) return;
        const a = byId.get(id);
        if (!a || a === active) return;
        active?.classList.remove('active');
        a.classList.add('active');
        active = a;
      };
      const obs = new IntersectionObserver(
        (entries) => {
          const vis = entries.filter((e) => e.isIntersecting).sort((x, y) => x.boundingClientRect.top - y.boundingClientRect.top);
          if (vis[0]) setActive(vis[0].target.id);
        },
        { rootMargin: '-80px 0px -70% 0px', threshold: 0 },
      );
      heads.forEach((h) => obs.observe(h));
    }
  </script>
</Layout>
