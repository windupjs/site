---
import CodeBlock from './CodeBlock.astro';

const reports = [
  { href: '/reports/windup-report.html', label: 'Full HTML report', note: 'suite run, 9/10 (one external demo site down)' },
  { href: '/reports/windup-report-replay.html', label: 'Replay report', note: 'same suite from cache — llm_calls=0, $0' },
  { href: '/reports/windup-report-summary.html', label: '--summary run', note: 'AI debrief quoting real page values' },
  { href: '/reports/windup-report-suggest.html', label: '--suggest run', note: 'a failure, with an AI-suggested fix' },
];

const ciHtml = `<span class="tok-muted">$</span> npx windup run --all --reporter junit \\
    --report-file reports/windup.xml`;
---

<section class="section cicd">
  <div class="wrap">
    <p class="kicker">CI / CD</p>
    <h2 class="section-title">Drop it into your pipeline. Exit codes and reports included.</h2>
    <p class="section-note">
      Run the whole suite in one warm browser, fail the build on any failing scenario, and emit
      machine- or human-readable reports.
    </p>

    <div class="cicd-grid">
      <div>
        <CodeBlock label="ci — one line" lang="bash" html={ciHtml} />
        <ul class="cicd-points">
          <li><span class="mono">--all</span> runs every scenario in a single warm browser for the whole suite.</li>
          <li>Non-zero exit code when any scenario fails.</li>
          <li><span class="mono">--reporter junit|json|html</span>; <span class="mono">windup costs --json</span> tracks AI spend in the pipeline.</li>
        </ul>
      </div>

      <aside class="reports">
        <h3>Real reports (static HTML, no JS)</h3>
        <ul>
          {reports.map((r) => (
            <li>
              <a href={r.href} target="_blank" rel="noopener">{r.label} <span aria-hidden="true">↗</span></a>
              <span class="rnote">{r.note}</span>
            </li>
          ))}
          <li class="bench">
            <a href="/reports/llm-benchmark.html" target="_blank" rel="noopener">LLM planner benchmark <span aria-hidden="true">↗</span></a>
            <span class="rnote">Gemini vs OpenAI on the planner — accuracy, cost, latency.</span>
          </li>
        </ul>
      </aside>
    </div>
  </div>
</section>

<style>
  .cicd-grid { display: grid; grid-template-columns: 1.15fr .85fr; gap: 28px; align-items: start; }
  .cicd-points { list-style: none; margin: 16px 0 0; padding: 0; display: grid; gap: 10px; }
  .cicd-points li { font-size: 14px; color: var(--muted); padding-left: 16px; position: relative; }
  .cicd-points li::before { content: '▸'; color: var(--accent); position: absolute; left: 0; }
  .mono { font-family: var(--font-mono); font-size: .95em; color: var(--ink); }

  .reports {
    background: var(--card); border: 1px solid var(--line); border-radius: 10px;
    padding: 18px 20px; box-shadow: var(--shadow);
  }
  .reports h3 { margin: 0 0 12px; font-size: 13px; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); }
  .reports ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .reports li { display: grid; gap: 2px; }
  .reports li.bench { border-top: 1px solid var(--line); padding-top: 12px; }
  .reports a { font-size: 14px; font-weight: 600; }
  .rnote { font-size: 12.5px; color: var(--muted); }

  @media (max-width: 860px) { .cicd-grid { grid-template-columns: 1fr; } }
</style>
