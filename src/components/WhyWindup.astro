---
import { getUi, getLangFromUrl } from '../i18n';
const c = getUi(getLangFromUrl(Astro.url)).whyWindup;
const rows = c.rows;
---

<section class="section why">
  <div class="wrap">
    <p class="kicker">{c.kicker}</p>
    <h2 class="section-title">{c.title}</h2>
    <p class="section-note">{c.note}</p>

    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th scope="col"><span class="visually-hidden">{c.dimensionSr}</span></th>
            <th scope="col">{c.headers[0]}</th>
            <th scope="col">{c.headers[1]}</th>
            <th scope="col" class="col-windup">{c.headers[2]}</th>
          </tr>
        </thead>
        <tbody>
          {rows.map(([dim, a, b, c]) => (
            <tr>
              <th scope="row">{dim}</th>
              <td>{a}</td>
              <td>{b}</td>
              <td class="col-windup"><strong>{c}</strong></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  .why td strong { color: var(--accent); font-weight: 600; }
  .why tbody th { color: var(--ink); }
</style>
