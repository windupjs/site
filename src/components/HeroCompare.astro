---
// Hero visual: why a vision LLM agent is slow (perceive → think → act loop,
// seconds per step) vs Windup replaying a cached plan directly (~0.7s).
// Sits in place of the mascot in the hero.
---

<div class="hero-compare" data-compare aria-hidden="true">
  <div class="cmp agent">
    <span class="flash" data-a-flash></span>
    <div class="cmp-head">
      <span class="cmp-name">LLM agent</span>
      <span class="cmp-clock mono" data-a-clock>0.0s</span>
    </div>
    <p class="cmp-sub">sees &amp; thinks every step · <span data-a-act>1</span>/5</p>
    <ul class="phases">
      <li data-ph><span class="marker"></span> screenshot</li>
      <li data-ph><span class="marker"></span> analyze image</li>
      <li data-ph><span class="marker"></span> think</li>
      <li data-ph><span class="marker"></span> click / type</li>
    </ul>
    <p class="cmp-foot">↻ repeats every action</p>
  </div>

  <div class="cmp windup">
    <div class="cmp-head">
      <span class="cmp-name">Windup</span>
      <span class="cmp-clock mono" data-w-clock>0.0s</span>
    </div>
    <p class="cmp-sub">cached plan · no model</p>
    <ul class="wacts">
      <li data-wa><span class="marker"></span> click #login</li>
      <li data-wa><span class="marker"></span> fill #user</li>
      <li data-wa><span class="marker"></span> fill #pass</li>
      <li data-wa><span class="marker"></span> click #submit</li>
      <li data-wa><span class="marker"></span> verify</li>
    </ul>
    <p class="cmp-foot done" data-w-done>done — while the agent still thinks</p>
  </div>
</div>

<style>
  .hero-compare { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; width: 100%; }
  .cmp {
    position: relative; overflow: hidden;
    background: var(--card); border: 1px solid var(--line); border-radius: 12px;
    padding: 13px 13px 12px; box-shadow: var(--shadow);
  }
  .cmp.agent { border-top: 2px solid var(--fail); }
  .cmp.windup { border-top: 2px solid var(--pass); }

  .cmp-head { display: flex; align-items: baseline; justify-content: space-between; gap: 6px; }
  .cmp-name { font-size: 13px; font-weight: 700; }
  .agent .cmp-name { color: var(--fail); }
  .windup .cmp-name { color: var(--pass); }
  .cmp-clock { font-size: 14px; font-weight: 700; font-variant-numeric: tabular-nums; }
  .agent .cmp-clock { color: var(--fail); }
  .windup .cmp-clock { color: var(--pass); }

  .cmp-sub { margin: 3px 0 11px; font-size: 11px; color: var(--muted); line-height: 1.3; }

  .phases, .wacts { list-style: none; margin: 0; padding: 0; display: grid; gap: 5px; }
  .phases li, .wacts li {
    display: flex; align-items: center; gap: 8px; padding: 5px 8px; border-radius: 7px;
    font-size: 12.5px; color: var(--muted);
  }
  .wacts li { font-family: var(--font-mono); font-size: 12px; }
  .marker { width: 9px; height: 9px; border-radius: 50%; border: 2px solid var(--line); flex: none; box-sizing: border-box; }

  .phases li.on { background: var(--fail-soft); color: var(--fail); }
  .phases li.on .marker { border-color: var(--fail); border-top-color: transparent; animation: cmp-spin .7s linear infinite; }
  @keyframes cmp-spin { to { transform: rotate(360deg); } }

  .wacts li.done { color: var(--pass); }
  .wacts li.done .marker { border-color: var(--pass); background: var(--pass); }

  .cmp-foot { margin: 10px 0 0; font-size: 11px; color: var(--muted); }
  .cmp-foot.done { color: var(--pass); opacity: 0; transition: opacity .25s; }

  .flash {
    position: absolute; inset: 0; background: #fff; opacity: 0;
    pointer-events: none; border-radius: inherit;
  }

  @media (max-width: 420px) {
    .hero-compare { gap: 8px; }
    .cmp { padding: 11px; }
  }
</style>

<script>
  function initCompare() {
    const box = document.querySelector<HTMLElement>('[data-compare]');
    if (!box || box.dataset.bound) return;
    box.dataset.bound = '1';
    const phases = Array.from(box.querySelectorAll<HTMLElement>('.phases li'));
    const wacts = Array.from(box.querySelectorAll<HTMLElement>('.wacts li'));
    const aClock = box.querySelector<HTMLElement>('[data-a-clock]');
    const wClock = box.querySelector<HTMLElement>('[data-w-clock]');
    const aAct = box.querySelector<HTMLElement>('[data-a-act]');
    const flash = box.querySelector<HTMLElement>('[data-a-flash]');
    const wDone = box.querySelector<HTMLElement>('[data-w-done]');
    if (!aClock || !wClock || !aAct || !flash || !wDone) return;

    // Real-time dwells so the loop actually feels slow: screenshot 2s,
    // analyze 4s, think 2s, act 2s = 10s per action, ~50s for the run.
    const ACT = 10000, A_TOTAL = ACT * 5, W_TOTAL = 700, HOLD = 3000, CYCLE = A_TOTAL + HOLD;
    const fmt = (s: number) => {
      if (s < 60) return s.toFixed(1) + 's';
      const m = Math.floor(s / 60), r = Math.round(s - m * 60);
      return m + 'm ' + (r < 10 ? '0' : '') + r + 's';
    };
    function render(t: number) {
      const at = Math.min(t, A_TOTAL);
      const actionIdx = Math.min(4, Math.floor(at / ACT));
      const msInto = at - actionIdx * ACT;
      const within = msInto / ACT;
      const ph = t >= A_TOTAL ? -1 : within < 0.2 ? 0 : within < 0.6 ? 1 : within < 0.8 ? 2 : 3;
      phases.forEach((p, i) => p.classList.toggle('on', i === ph));
      aAct!.textContent = String(actionIdx + 1);
      aClock!.textContent = fmt(at / 1000);
      flash!.style.opacity = ph === 0 ? String(Math.max(0, 0.45 * (1 - msInto / 400))) : '0';

      const wt = Math.min(t, W_TOTAL);
      const wn = wt >= W_TOTAL ? 5 : Math.floor(wt / (W_TOTAL / 5));
      wacts.forEach((el, i) => el.classList.toggle('done', i < wn));
      wClock!.textContent = ((wt / W_TOTAL) * 0.7).toFixed(1) + 's';
      wDone!.style.opacity = wt >= W_TOTAL ? '1' : '0';
    }
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      render(A_TOTAL); wacts.forEach((el) => el.classList.add('done')); return;
    }
    let start: number | null = null;
    function frame(ts: number) {
      if (start === null) start = ts;
      render((ts - start) % CYCLE);
      requestAnimationFrame(frame);
    }
    requestAnimationFrame(frame);
  }
  initCompare();
  document.addEventListener('astro:page-load', initCompare);
</script>
