---
import { getUi, getLangFromUrl } from '../i18n';
const c = getUi(getLangFromUrl(Astro.url)).pitch;
---

<section class="section pitch">
  <div class="wrap">
    <p class="kicker">{c.kicker}</p>
    <p class="pitch-lede" set:html={c.p1Html}></p>
    <p class="pitch-lede accent" set:html={c.p2Html}></p>
  </div>
</section>

<style>
  .pitch-lede {
    font-size: clamp(19px, 2.6vw, 24px); line-height: 1.5; font-weight: 500;
    max-width: 58ch; margin: 0 0 16px; color: var(--muted);
  }
  .pitch-lede strong { color: var(--ink); font-weight: 700; }
  .pitch-lede.accent { color: var(--ink); }
  .pitch-lede em { color: var(--accent); font-style: normal; }
</style>
