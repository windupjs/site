---
import { getUi, getLangFromUrl, localizedPath } from '../i18n';
import CopyCommand from './CopyCommand.astro';
const lang = getLangFromUrl(Astro.url);
const c = getUi(lang).record;
---

<section id="record" class="section record">
  <div class="wrap">
    <p class="kicker">{c.kicker}</p>
    <h2 class="section-title">{c.title} <span class="mono-cmd">windup record</span></h2>
    <p class="section-note" set:html={c.lead}></p>

    <div class="rec-cmd"><CopyCommand command={c.cmd} prompt="" /></div>

    <div class="rec-steps">
      {c.steps.map((s) => (
        <article class="rec-step">
          <span class="n">{s.n}</span>
          <h3>{s.title}</h3>
          <p>{s.body}</p>
        </article>
      ))}
    </div>

    <ul class="rec-points">
      {c.points.map((p) => (<li set:html={p}></li>))}
    </ul>

    <a class="rec-doc" href={localizedPath(lang, c.docHref)}>{c.docLabel}</a>
  </div>
</section>

<style>
  .record .mono-cmd { font-family: var(--font-mono); font-size: .78em; color: var(--accent); }
  .rec-cmd { max-width: 560px; margin: 0 0 30px; }

  .rec-steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin: 0 0 26px; }
  .rec-step {
    position: relative; background: var(--card); border: 1px solid var(--line);
    border-radius: 12px; padding: 20px 18px 18px; box-shadow: var(--shadow);
  }
  .rec-step .n {
    display: inline-flex; align-items: center; justify-content: center;
    width: 26px; height: 26px; border-radius: 50%;
    background: var(--accent-soft); color: var(--accent);
    font-family: var(--font-mono); font-weight: 700; font-size: 13px; margin-bottom: 12px;
  }
  .rec-step h3 { margin: 0 0 6px; font-size: 15px; }
  .rec-step p { margin: 0; font-size: 13.5px; color: var(--muted); line-height: 1.5; }
  /* connective arrows between steps (desktop) */
  .rec-step:not(:last-child)::after {
    content: '→'; position: absolute; right: -13px; top: 26px;
    color: var(--line); font-size: 18px; z-index: 1;
  }

  .rec-points { list-style: none; margin: 0 0 24px; padding: 0; display: grid; gap: 8px; max-width: 78ch; }
  .rec-points li {
    position: relative; padding-left: 24px; font-size: 13.5px; color: var(--muted); line-height: 1.5;
  }
  .rec-points li::before {
    content: '✓'; position: absolute; left: 0; top: 0; color: var(--accent); font-weight: 700;
  }
  .rec-points strong { color: var(--ink); font-weight: 600; }

  .rec-doc { font-size: 14px; color: var(--accent); text-decoration: none; font-weight: 600; }
  .rec-doc:hover { text-decoration: underline; text-underline-offset: 2px; }

  @media (max-width: 780px) {
    .rec-steps { grid-template-columns: 1fr; }
    .rec-step:not(:last-child)::after { content: '↓'; right: auto; left: 12px; top: auto; bottom: -14px; }
  }
</style>
