---
import { getUi, getLangFromUrl } from '../i18n';
const c = getUi(getLangFromUrl(Astro.url)).howItWorks;
const { flow } = c;
---

<section id="how" class="section how">
  <div class="wrap">
    <p class="kicker">{c.kicker}</p>
    <h2 class="section-title">{c.title}</h2>
    <p class="section-note">{c.note}</p>

    <!-- Flow diagram -->
    <div class="flow" role="img" aria-label={c.flowAria}>
      <div class="node in">{flow.task}</div>
      <div class="arrow">→</div>
      <div class="node accent">{flow.planner}<span>{flow.plannerSub}</span></div>
      <div class="arrow">→</div>
      <div class="node">{flow.plan}</div>
      <div class="arrow">→</div>
      <div class="node">{flow.executor}<span>{flow.executorSub}</span></div>
      <div class="arrow down">↓</div>
      <div class="node cache">{flow.cache}</div>
      <div class="arrow tail">→</div>
      <div class="node pass">{flow.next}</div>
    </div>

    <ol class="steps">
      {c.steps.map((s, i) => (
        <li class="step-card">
          <span class="step-n">{i + 1}</span>
          <h3>{s.title}</h3>
          <p>{s.body}</p>
          <span class="step-meta">{s.meta}</span>
        </li>
      ))}
    </ol>

    <ul class="principles">
      {c.principles.map(([t, d]) => (
        <li><strong>{t}</strong> — {d}</li>
      ))}
    </ul>
  </div>
</section>

<style>
  .flow {
    display: flex; flex-wrap: wrap; align-items: center; gap: 10px;
    background: var(--code-bg); border: 1px solid var(--line); border-radius: 12px;
    padding: 22px; margin-bottom: 34px;
  }
  .node {
    font-family: var(--font-mono); font-size: 13px; line-height: 1.3;
    background: var(--card); border: 1px solid var(--line); border-radius: 8px;
    padding: 10px 14px; color: var(--ink); text-align: center;
  }
  .node span { display: block; font-size: 10.5px; color: var(--muted); margin-top: 2px; }
  .node.in { border-style: dashed; }
  .node.accent { border-color: var(--accent); color: var(--accent); }
  .node.cache { border-color: var(--accent); background: var(--accent-soft); }
  .node.pass { border-color: var(--pass); color: var(--pass); background: var(--pass-soft); }
  .arrow { color: var(--muted); font-size: 18px; flex: none; }
  .arrow.tail { color: var(--pass); }

  .steps {
    list-style: none; margin: 0 0 30px; padding: 0;
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px;
  }
  .step-card { position: relative; }
  .step-card {
    background: var(--card); border: 1px solid var(--line); border-radius: 10px;
    padding: 20px 18px; box-shadow: var(--shadow);
  }
  .step-n {
    display: inline-flex; align-items: center; justify-content: center;
    width: 28px; height: 28px; border-radius: 8px; background: var(--accent-soft);
    color: var(--accent); font-family: var(--font-mono); font-weight: 700; font-size: 14px;
    margin-bottom: 12px;
  }
  .step-card h3 { margin: 0 0 6px; font-size: 16px; }
  .step-card p { margin: 0 0 12px; font-size: 14px; color: var(--muted); }
  .step-meta {
    font-family: var(--font-mono); font-size: 11.5px; color: var(--accent);
    background: var(--code-bg); border: 1px solid var(--line); border-radius: 6px;
    padding: 3px 8px; display: inline-block;
  }

  .principles {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: 1fr 1fr; gap: 10px 28px;
  }
  .principles li { font-size: 14px; color: var(--muted); padding-left: 16px; position: relative; }
  .principles li::before { content: '▸'; color: var(--accent); position: absolute; left: 0; }
  .principles strong { color: var(--ink); font-weight: 600; }

  @media (max-width: 820px) {
    .steps { grid-template-columns: 1fr; }
    .principles { grid-template-columns: 1fr; }
    .arrow.down { display: none; }
  }
</style>
